#!/usr/bin/env python3
"""Record a demo GIF against the fake AdGuard Home (see tools/screenshot).

    tools/demo-gif [out.gif]

Needs pyte and Pillow; the app itself stays stdlib only.
"""
import importlib.util
import os
import sys
from importlib.machinery import SourceFileLoader

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))


def load(name):
    _loader = SourceFileLoader(name, os.path.join(ROOT, "tools", name))
    _spec = importlib.util.spec_from_loader(name, _loader)
    mod = importlib.util.module_from_spec(_spec)
    _loader.exec_module(mod)
    return mod


shot = load("screenshot")
smoke = load("smoke")

STEPS = [  # (keys, hold the resulting screen in ms)
    ([], 1600),                    # the query log
    (list("doubleclick"), 1200),   # type-to-filter
    (["F6"], 1600),                # the unblock menu
    (["Esc", "Esc"], 800),         # close the menu, clear the filter
    (["F2"], 1600),                # the custom rules manager
    (["F1"], 1600),                # the key help
    (["Esc", "Esc"], 800),         # back to the log
]


def main():
    out = sys.argv[1] if len(sys.argv) > 1 else os.path.join(ROOT, "docs", "demo.gif")
    app = smoke.App(cols=110, rows=30)
    frames = []
    try:
        for keys, hold in STEPS:
            for k in keys:
                app.key(k, wait=0.35)
            app.pump(hold / 1000)
            frames.append((shot.render_image(app.screen), hold))
    finally:
        app.kill()
    imgs, durations = zip(*frames)
    imgs[0].save(out, save_all=True, append_images=list(imgs[1:]),
                 duration=list(durations), loop=0)
    print("wrote", out, "(%d frames)" % len(frames))


if __name__ == "__main__":
    main()
